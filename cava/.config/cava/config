# ==============================================================================
# Cava Audio Visualizer Configuration
# ==============================================================================

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
style = stereo

[color]
# Gradient Catppuccin Mocha
gradient = 1
gradient_count = 5
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#94e2d5'
gradient_color_3 = '#a6e3a1'
gradient_color_4 = '#f9e2af'
gradient_color_5 = '#cba6f7'

[smoothing]
monstercat = 1
waves = 0
gravity = 100
integral = 77
