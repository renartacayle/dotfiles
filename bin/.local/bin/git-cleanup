#!/usr/bin/env bash
# ==============================================================================
# Script: git-cleanup
# Deskripsi: Membersihkan branch lokal yang sudah di-merge atau terhapus di remote
# ==============================================================================

set -euo pipefail

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "${RED}[ERROR]${NC} Perintah ini harus dijalankan di dalam repositori Git!"
    exit 1
fi

MAIN_BRANCH="main"
if ! git show-ref --quiet refs/heads/main; then
    if git show-ref --quiet refs/heads/master; then
        MAIN_BRANCH="master"
    fi
fi

echo -e "${BLUE}[INFO]${NC} Memeriksa status branch terhadap branch utama (${MAIN_BRANCH})..."

# Prune remote tracking
git fetch -p 2>/dev/null || true

# Cari branch lokal yang upstream-nya sudah 'gone'
GONE_BRANCHES=$(git branch -vv | awk '/: gone]/ {print $1}' | tr -d '*' || true)

if [ -n "${GONE_BRANCHES}" ]; then
    echo -e "${YELLOW}[WARN]${NC} Menemukan branch yang sudah dihapus di remote:"
    echo "${GONE_BRANCHES}"
    read -rp "Hapus branch-branch ini sekarang? [y/N]: " confirm
    if [[ "${confirm}" =~ ^[Yy]$ ]]; then
        echo "${GONE_BRANCHES}" | xargs -r git branch -D
        echo -e "${GREEN}[SUCCESS]${NC} Branch usang berhasil dibersihkan!"
    fi
else
    echo -e "${GREEN}[SUCCESS]${NC} Repositori bersih, tidak ada branch lokal yang dangling."
fi
