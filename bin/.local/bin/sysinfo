#!/usr/bin/env bash
# ==============================================================================
# Script: sysinfo
# Deskripsi: Dashboard status sistem minimalis dan cepat (CPU, RAM, Disk, Uptime)
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${CYAN}====================================================${NC}"
echo -e "${BOLD}${PURPLE}             SYSTEM STATUS DASHBOARD                ${NC}"
echo -e "${BOLD}${CYAN}====================================================${NC}"

# Host & Uptime
HOST_NAME=$(hostname)
UPTIME_STR=$(uptime -p 2>/dev/null || uptime | awk -F'( |,|:)+' '{print $6,"hrs",$7,"min"}')
echo -e "${BOLD}${BLUE}Host       :${NC} ${HOST_NAME}"
echo -e "${BOLD}${BLUE}Uptime     :${NC} ${UPTIME_STR}"

# Kernel & OS
if [ -f /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    echo -e "${BOLD}${BLUE}OS         :${NC} ${PRETTY_NAME:-Linux}"
fi
echo -e "${BOLD}${BLUE}Kernel     :${NC} $(uname -r)"

# CPU Info & Load Average
CPU_MODEL=$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^[ \t]*//' || echo "Unknown CPU")
LOAD_AVG=$(cut -d ' ' -f 1-3 /proc/loadavg)
echo -e "${BOLD}${YELLOW}CPU        :${NC} ${CPU_MODEL}"
echo -e "${BOLD}${YELLOW}Load Avg   :${NC} ${LOAD_AVG}"

# RAM Usage
if command -v free >/dev/null 2>&1; then
    RAM_INFO=$(free -h | awk '/^Mem:/ {print $3 "/" $2 " (" int($3/$2*100) "%)"}')
    echo -e "${BOLD}${GREEN}Memory     :${NC} ${RAM_INFO}"
fi

# Disk Usage Root /
DISK_INFO=$(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')
echo -e "${BOLD}${GREEN}Disk (/)   :${NC} ${DISK_INFO}"

# IP Address
LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
echo -e "${BOLD}${CYAN}Local IP   :${NC} ${LOCAL_IP}"
echo -e "${BOLD}${CYAN}====================================================${NC}"
